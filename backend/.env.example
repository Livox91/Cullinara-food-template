DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurant?schema=public"
AUTH_JWT_SECRET="replace-with-at-least-32-characters"
AUTH_ISSUER="restaurant-backend"
AUTH_AUDIENCE="restaurant-clients"
CORS_ALLOWED_ORIGINS="http://localhost:3000"
LOG_LEVEL="info"
PAYMENT_WEBHOOK_SECRET="replace-with-at-least-16-characters"
WORKER_SECRET="replace-with-at-least-16-characters"
NOTIFICATION_WEBHOOK_URL="https://your-notification-service.example/events"
FRONTEND_URL="http://localhost:3000"

# SMTP mailbox used to send team invitations and verification codes.
# For Gmail, use smtp.gmail.com, port 465, secure true, and an app password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="owner@example.com"
SMTP_PASS="replace-with-an-app-password"
SMTP_FROM_EMAIL="owner@example.com"
SMTP_FROM_NAME="Restaurant Team"

# Menu image uploads. AWS credentials are read by the standard AWS SDK credential chain.
# S3_IMAGE_PUBLIC_BASE_URL can be a CloudFront distribution or a public S3 bucket URL.
AWS_REGION="ap-south-1"
S3_IMAGE_BUCKET="your-menu-image-bucket"
S3_IMAGE_PUBLIC_BASE_URL="https://images.example.com"
# For local development only. Prefer an IAM role in deployed environments.
# AWS_ACCESS_KEY_ID="replace-with-an-access-key"
# AWS_SECRET_ACCESS_KEY="replace-with-a-secret-key"
# Optional for S3-compatible local development (MinIO, LocalStack, etc.).
# S3_ENDPOINT="http://localhost:9000"
# S3_FORCE_PATH_STYLE="true"
